# .env.example
# Environment variables for Scorpion backend

# GitHub token for cloning private repositories (injected into clone URL)
GITHUB_TOKEN=your_github_token_here

# Slack webhook URL for notifications
SLACK_WEBHOOK_URL=your_slack_webhook_url_here

# Other existing variables (example placeholders)
PORT=3001
DB_ENDPOINT=https://[YOUR_APPWRITE_ENDPOINT]
DB_PROJECT=[YOUR_PROJECT_ID]
DB_API_KEY=[YOUR_API_KEY]
