# .env.example
# Environment variables for the Scorpion backend (backend/src/index.ts)

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Extra allowed CORS origins beyond FRONTEND_URL (comma-separated, e.g. staging/preview URLs)
ALLOWED_ORIGINS=

# Redis (backs the BullMQ scan-execution queue; see src/queues/)
REDIS_URL=redis://localhost:6379

# Appwrite (database/auth backend)
APPWRITE_ENDPOINT=https://[YOUR_APPWRITE_REGION].cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_DATABASE_ID=your_appwrite_database_id
APPWRITE_API_KEY=your_appwrite_server_api_key

# GitHub App (used for CI orchestration / GitOps rollback / webhooks)
# Paste the PEM contents with literal \n in place of newlines - the app
# does GITHUB_APP_PRIVATE_KEY.replace(/\\n/g, '\n') before use.
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY=your_github_app_private_key_pem
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
SCORPION_WEBHOOK_SECRET=your_scorpion_webhook_secret

# GitHub token for cloning private repositories (injected into clone URL)
GITHUB_TOKEN=your_github_token_here

# GitLab (optional, only needed if scanning GitLab repos)
GITLAB_TOKEN=your_gitlab_token_here
GITLAB_WEBHOOK_SECRET=your_gitlab_webhook_secret

# Other CI/CD provider integrations (optional)
AZURE_ORG=your_azure_devops_org

# Email (Resend) - sending OTPs/alerts is disabled (logged only) if unset
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# Notifications (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# AI providers used for summaries/chat features
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# Password reset tokens
RESET_TOKEN_SECRET=your_reset_token_signing_secret

# DAST (OWASP ZAP)
ZAP_BASE_URL=http://localhost:8090
ZAP_API_KEY=your_zap_api_key

# Runtime security (Falco)
FALCO_SECRET=your_falco_shared_secret

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOKI_URL=http://localhost:3100
