# .env.example
# Environment variables for the Scorpion backend (backend/src/index.ts)

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Set to "true" ONLY for local development to allow the no-token mock-developer
# auth bypass on routes that use verifyUser. Never set this in any deployed/shared
# environment — it disables authentication on those routes.
ALLOW_DEV_AUTH_BYPASS=false
# Extra allowed CORS origins beyond FRONTEND_URL (comma-separated, e.g. staging/preview URLs)
ALLOWED_ORIGINS=

# Redis (backs the BullMQ scan-execution queue; see src/queues/)
REDIS_URL=redis://localhost:6379

# Appwrite (database/auth backend)
APPWRITE_ENDPOINT=https://[YOUR_APPWRITE_REGION].cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_DATABASE_ID=your_appwrite_database_id
APPWRITE_API_KEY=your_appwrite_server_api_key

# GitHub App (used for CI orchestration / GitOps rollback / webhooks)
# Paste the PEM contents with literal \n in place of newlines - the app
# does GITHUB_APP_PRIVATE_KEY.replace(/\\n/g, '\n') before use.
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY=your_github_app_private_key_pem
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
SCORPION_WEBHOOK_SECRET=your_scorpion_webhook_secret

# GitHub token for cloning private repositories (injected into clone URL)
GITHUB_TOKEN=your_github_token_here

# GitLab (optional, only needed if scanning GitLab repos)
GITLAB_TOKEN=your_gitlab_token_here
GITLAB_WEBHOOK_SECRET=your_gitlab_webhook_secret

# Other CI/CD provider integrations (optional)
AZURE_ORG=your_azure_devops_org

# Email (Resend) - sending OTPs/alerts is disabled (logged only) if unset
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# Notifications (optional)
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# AI providers used for summaries/chat features
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=<your-gemini-api-key>

# Password reset tokens
RESET_TOKEN_SECRET=your_reset_token_signing_secret

# DAST (OWASP ZAP)
ZAP_BASE_URL=http://localhost:8090
ZAP_API_KEY=your_zap_api_key

# Runtime security (Falco)
FALCO_SECRET=your_falco_shared_secret

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Push endpoint. Also where the audit ledger's tamper anchors are written: each
# ledger row's hash is shipped here so a rewrite of audit_logs_v2 by anyone holding
# APPWRITE_API_KEY can be detected. Anchoring is production-only (see
# services/logger). Unset in production means the ledger is never cross-checked
# against anything outside the database it lives in.
LOKI_URL=http://localhost:3100
# Query endpoint for reading those anchors back. Defaults to LOKI_URL. Set it
# separately when writes go to a distributor and reads go through a query-frontend
# — otherwise the verifier queries the wrong service and reports ANCHOR_UNAVAILABLE,
# which reads as an outage rather than a misconfiguration.
LOKI_QUERY_URL=
# Bearer token, if your Loki query path is authenticated.
LOKI_QUERY_TOKEN=

# System alerts (audit ledger tampering, anchor-store blindness)
#
# Deliberately separate from the per-user integrations in alertDispatcher's
# sendFindingAlert: a tampered ledger has no owning user or repository, and must
# not be filtered out by someone's min_severity preference or lost because nobody
# configured a webhook.
#
# With NONE of these set, the alert reaches the application log and nothing else.
# That fact is logged loudly, but nobody reads that line until they are already
# investigating — which is exactly when it is too late. Set at least one in
# production.
SYSTEM_ALERT_PAGERDUTY_KEY=
SYSTEM_ALERT_SLACK_WEBHOOK=
SYSTEM_ALERT_WEBHOOK_URL=

# Remediation (optional - defaults to process.cwd() if unset)
LOCAL_SCAN_WORKSPACE_DIR=/path/to/local/repo/checkout

# IaC engine (OpenTofu-based)
# Master key for encrypting cloud credential profiles at rest (required to use /api/iac/credentials)
IAC_CRED_KEY=your_iac_credential_encryption_key
# Optional overrides
# IAC_DATA_DIR=/path/to/iac/data
# IAC_TOFU_IMAGE=ghcr.io/opentofu/opentofu:1.8
# IAC_CHECKOV_IMAGE=bridgecrew/checkov:latest

# Enterprise SSO (generic OIDC - Okta, Auth0, Entra ID, Keycloak, ...)
# All three must be set to enable /auth/sso; frontend needs VITE_SSO_ENABLED=true
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional: defaults to <backend origin>/auth/sso/callback
OIDC_REDIRECT_URL=
