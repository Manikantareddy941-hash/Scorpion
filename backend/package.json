{
    "name": "devops-task-tracker-backend",
    "version": "1.0.0",
    "description": "Backend worker service for DevOps Task Tracker",
    "main": "dist/backend/src/index.js",
    "scripts": {
        "start": "node dist/backend/src/index.js",
        "dev": "cross-env PYTHONUTF8=1 ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "prisma generate && tsc",
        "db:generate": "prisma generate",
        "prisma:generate:pg": "prisma generate --schema prisma/schema.postgres.prisma",
        "lint": "eslint \"{src,scripts}/**/*.{ts,js}\"",
        "test": "jest",
        "migrate:up": "node-pg-migrate up -m migrations",
        "migrate:down": "node-pg-migrate down -m migrations",
        "setup:teams": "ts-node src/scripts/setup-teams.ts",
        "migrate:reports": "ts-node src/scripts/migrate_reports_collection.ts",
        "migrate:permissions": "ts-node src/scripts/migrate_permissions_audit.ts",
        "migrate:repo-tenancy": "ts-node src/scripts/migrate_repo_tenancy.ts",
        "setup-tools": "bash setup-tools.sh",
        "postinstall": "bash setup-tools.sh"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@kubernetes/client-node": "^1.4.0",
