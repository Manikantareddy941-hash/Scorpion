{
    "compilerOptions": {
        "target": "es2016",
        "module": "commonjs",
        "rootDir": "..",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node", "jest"],
        "forceConsistentCasingInFileNames": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false
    },
    "include": ["src/**/*", "scripts/**/*", "**/*.test.ts"],
    "exclude": ["node_modules"]
}
