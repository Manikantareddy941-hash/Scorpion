# .env.example
# Environment variables for the Scorpion frontend (Vite)

VITE_APPWRITE_ENDPOINT=https://[YOUR_APPWRITE_REGION].cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_APPWRITE_DATABASE_ID=your_appwrite_database_id
VITE_APPWRITE_REPOS_COLLECTION_ID=repositories
VITE_APPWRITE_SCANS_COLLECTION_ID=scans
VITE_APPWRITE_VULNS_COLLECTION_ID=vulnerabilities
VITE_APPWRITE_TASKS_COLLECTION_ID=tasks
VITE_APPWRITE_FINDINGS_COLLECTION_ID=findings
VITE_APPWRITE_FUNCTION_ID=trivy-scanner
VITE_APPWRITE_INTEGRATIONS_COLLECTION_ID=integrations
VITE_APPWRITE_POLICIES_COLLECTION_ID=policies
VITE_APPWRITE_CHAT_SESSIONS_ID=chat_sessions

# Base URL for the backend API (leave blank to use relative paths / same origin)
VITE_API_URL=

# Server-side Appwrite admin key (only needed for local Appwrite functions, never expose to the browser)
APPWRITE_API_KEY=your_appwrite_server_api_key

# Third-party AI provider keys used by frontend-triggered features
VITE_HUGGINGFACE_API_KEY=your_huggingface_api_key
VITE_GEMINI_API_KEY=your_gemini_api_key

# Demo seeding. When 'true', first login writes the MOCK_* fixtures from
# src/lib/demoData.ts into Appwrite so a demo deployment has data to show.
# Leave unset on any deployment with real users: it writes repositories, scans
# and findings into the account that signs in.
VITE_DEMO_MODE=false
